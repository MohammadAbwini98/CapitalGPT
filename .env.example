CAPITAL_REST_BASE_URL=https://api-capital.backend-capital.com
CAPITAL_STREAM_URL=https://push.capital.com

CAPITAL_API_KEY=YOUR_API_KEY
CAPITAL_IDENTIFIER=YOUR_LOGIN_IDENTIFIER
CAPITAL_PASSWORD=YOUR_PASSWORD

