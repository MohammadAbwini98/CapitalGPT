CAPITAL_INSTRUMENTS=GOLD,SILVER,ETHUSD,BTCUSD

CAPITAL_STREAM_MODE=MERGE
CAPITAL_PRINT_JSON=true

CAPITAL_MARKET_STATUS_POLL_MS=15000
CAPITAL_RECONNECT_MIN_MS=500
CAPITAL_RECONNECT_MAX_MS=10000
